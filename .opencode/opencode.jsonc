{
  "$schema": "https://opencode.ai/config.json",

  // Frontier models plan and review; cheap models implement.
  // Project-local to Dicty. Custom agents live in .opencode/agents/.
  "agents": {
    "build": {
      "model": "github-copilot/claude-opus-5.5"
    },
    "plan": {
      "model": "github-copilot/claude-opus-5.5"
    },
    "explore": {
      // Read-only reconnaissance; safe to run on a cheap model.
      "model": "github-copilot/gpt-6-luna"
    }
  }
}
