# LLM Providers Configuration
# To use OpenRouter:
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=openrouter/google/gemini-2.5-flash # Default model to use

# To use a local Ollama instance (inside or outside Docker):
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Application Configuration
APP_ENV=development
PORT=8000

# GitHub Integration (Optional - for fetching PRs/Issues)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=owner/repo-name

# Notion Integration (Optional - for documentation publishing)
NOTION_API_KEY=your-notion-api-key
NOTION_PAGE_ID=your-parent-notion-page-id-or-database-id
# Obsidian Integration (Optional - path to local Obsidian vault for Docker mounting)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
